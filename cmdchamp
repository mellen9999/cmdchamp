_mp_show() {
  local cmd=$1 _t; local data="${MANPAGE[$cmd]}"
  printf -v _t "%s %s\n" "${W}${B}${cmd}${N}" "${D}- ${data%%$'\n'*}${N}"; _EBUF+=$_t
  printf -v _t '%s\n' "${data#*$'\n'}"; _EBUF+=$_t
}

