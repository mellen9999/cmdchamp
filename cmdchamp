    b) ((_re>0)) && ((_re--)); while ((_re>0)) && [[ "${input:_re:1}" == " " ]]; do ((_re--)); done; while ((_re>0)) && [[ "${input:_re-1:1}" != " " ]]; do ((_re--)); done; _rs=$_re; _re=$cursor;;
