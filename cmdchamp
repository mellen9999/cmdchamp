  PLAYER_NAME="${PLAYER_NAME//$'\r'/}"            # strip carriage returns
  PLAYER_NAME="${PLAYER_NAME:0:20}"              # truncate to 20 chars
  [[ -z "$PLAYER_NAME" ]] && PLAYER_NAME="anon"
  BOSS_BEATEN=0
