  done
  # Normalize tar: sort bundled option chars (xzf == fxz == zxf)
  if [[ "$REPLY" == tar && ${#args[@]} -gt 0 && "${args[0]}" =~ ^[a-zA-Z]+$ ]]; then
    local _tca=() _ti _tj _tt _tr=""
    for ((_ti=0; _ti<${#args[0]}; _ti++)); do _tca+=("${args[0]:_ti:1}"); done
    for ((_ti=1; _ti<${#_tca[@]}; _ti++)); do
      _tt="${_tca[$_ti]}"
      for ((_tj=_ti; _tj>0; _tj--)); do [[ "${_tca[$((_tj-1))]}" > "$_tt" ]] || break; _tca[$_tj]="${_tca[$((_tj-1))]}"; done
      _tca[$_tj]="$_tt"
    done
    for _ti in "${_tca[@]}"; do _tr+="$_ti"; done; args[0]="$_tr"
  fi
  local i j tmp
  for ((i=1; i<${#flags[@]}; i++)); do
    tmp="${flags[$i]}"
    for ((j=i; j>0; j--)); do [[ "${flags[$((j-1))]}" > "$tmp" ]] || break; flags[$j]="${flags[$((j-1))]}"; done
    flags[$j]="$tmp"
  done
  ((${#flags[@]})) && { for p in "${flags[@]}"; do REPLY+=" $p"; done; }
  ((${#args[@]})) && { for p in "${args[@]}"; do REPLY+=" $p"; done; }
  ((_saw_dashdash)) && { REPLY+=" --"; for p in "${postdd[@]}"; do REPLY+=" $p"; done; }
}

_SANDBOX_REQUIRE_FAIL=0
# Commands that can't meaningfully run in the bwrap sandbox (no network, no root,
# binary may be missing, or interactive). For these, skip exec — text_match still
# decides correctness, but we don't pollute output with misleading errors.
_can_sandbox() {
  local _cmd=$1
  # Strip leading `sudo ` (with optional flags) so we judge by the real command
  while [[ $_cmd == sudo\ * ]]; do
    _cmd=${_cmd#sudo }
    while [[ $_cmd == -* ]]; do _cmd=${_cmd#* }; done
  done
  local _c=${_cmd%% *}; _c=${_c##*/}
  # `sudo` alone (no following command) — can't run anyway
  [[ -z "$_c" || "$_c" == "sudo" ]] && return 1
  case "$_c" in
    ssh|scp|sftp|rsync|curl|wget|nc|ncat|ping|ping6|traceroute|tracepath|tracert|mtr|dig|nslookup|host|drill|whois|ftp|telnet|smbclient|nmap|masscan|enum4linux) return 1 ;;
    sudo|systemctl|service|useradd|userdel|usermod|passwd|groupadd|groupdel|groupmod|chown|chgrp|mount|umount|iptables|ip6tables|nft|ufw|fail2ban-client|crontab|systemd-run|at|atq|atrm|batch) return 1 ;;
    hashcat|john|hydra|medusa|nikto|gobuster|wpscan|sqlmap|aircrack-ng|airodump-ng|aireplay-ng|reaver|wifite|wash|kismet|airmon-ng|airbase-ng|hostapd|bettercap|mdk4|gatttool|hcxdumptool|hcxpcapngtool|bully) return 1 ;;
    foremost|scalpel|photorec|volatility|vol|vol3|vol.py|vol3.py|fls|mactime|tsk_recover|exiftool|tshark|tcpdump|tcpreplay|wireshark|binwalk|bulk_extractor|stegseek|stegoveritas|steghide) return 1 ;;
    zip2john|pdf2john|rar2john|ssh2john|office2john|unshadow|keepass2john) return 1 ;;
    docker|podman|kubectl|virsh|lxc|qemu*|vagrant) return 1 ;;
    vi|vim|nvim|nano|emacs|joe|less|more|view|man|info|top|htop|btop|atop|iotop|watch|bashtop) return 1 ;;
    tmux|screen|byobu) return 1 ;;
    dd) [[ "$1" == *"if=/dev/sd"* || "$1" == *"of=/dev/sd"* ]] && return 1 ;;
  esac
  return 0
}
_sandbox_validate() {
  local inp=$1 output _sb_rc _req_fail=0
  # Require is an anti-cheat gate (input must contain the expression, not a hardcoded
  # result); compare whitespace-insensitively so legal operator spacing like "3 + 4"
  # for require "3+4" still satisfies it. Correctness is still gated by #output.
  [[ -n "$_qrequire" && "${inp// /}" != *"${_qrequire// /}"* ]] && _req_fail=1
  _SANDBOX_REQUIRE_FAIL=0
  if ! _can_sandbox "$inp"; then
    ((_req_fail)) && _SANDBOX_REQUIRE_FAIL=1
    return 1
  fi
  # Redirect sandbox stderr to a file so it stays off-screen and out of the graded
  # output; the contents aren't inspected, only kept from leaking into the UI.
  output=$(_sandbox_exec "$inp" 5 2>"$SANDBOX_DIR/.stderr"); _sb_rc=$?
  _is_destructive "$inp" && _SANDBOX_DESTRUCTIVE=1
  # Reject command-not-found (127) and cannot-execute (126)
  ((_sb_rc == 127 || _sb_rc == 126)) && { ((_req_fail)) && _SANDBOX_REQUIRE_FAIL=1; return 1; }
  local _out_ok=0 _st_ok=0
  [[ -n "$_qoutput" ]] && _sandbox_check_output "$output" "$_qoutput" && _out_ok=1
  [[ -n "$_qstate" ]] && _sandbox_check_state "$_qstate" && _st_ok=1
  local _would_pass=0
  if [[ -n "$_qoutput" && -n "$_qstate" ]]; then
    ((_out_ok && _st_ok)) && _would_pass=1
  elif ((_out_ok || _st_ok)); then
    _would_pass=1
  fi
  if ((_req_fail)); then
    # 2 = right command, wrong string; 1 = just wrong
    _SANDBOX_REQUIRE_FAIL=$((_would_pass ? 2 : 1))
    return 1
  fi
  ((_would_pass)) && return 0
  return 1
}

# Operator skeleton: the ordered sequence of TOP-LEVEL shell operators in a command
# (>, >>, <, <<<, |, &&, ||, ;, &, 2>, 2>&1, ...). Quoted text, backslash escapes
# (find's \;), command substitutions, (( )) arithmetic and [[ ]] tests are structure,
# not top level, so operators inside them are skipped.
# Canonical forms so equivalent spellings share a skeleton:
#   1> == >   |   &>f / >&f == "> 2>&1"   |   cmd |& == "2>&1 |"   |   >&2 == 1>&2
# Adjacent duplicates collapse, so a 4-stage pipeline matches a 3-stage one — pipe
# COUNT was never what a level teaches, and collapsing keeps alternate approaches alive.
# shellcheck disable=SC1003  # '\' is a literal backslash, not a botched quote escape
_opskel() {
  local s=$1
  local n=${#s} i=0 c t fd tgt out="" prev="" depth=0 bdepth=0
  while ((i < n)); do
    c=${s:i:1}
    if [[ $c == "'" ]]; then
      ((i++)); while ((i < n)) && [[ ${s:i:1} != "'" ]]; do ((i++)); done; ((i++)); continue
    elif [[ $c == '"' ]]; then
      ((i++)); while ((i < n)) && [[ ${s:i:1} != '"' ]]; do [[ ${s:i:1} == '\' ]] && ((i++)); ((i++)); done; ((i++)); continue
    elif [[ $c == '`' ]]; then
      ((i++)); while ((i < n)) && [[ ${s:i:1} != '`' ]]; do ((i++)); done; ((i++)); continue
    elif [[ $c == '\' ]]; then ((i += 2)); continue
    elif [[ $c == '(' ]]; then depth=$((depth + 1)); ((i++)); continue
    elif [[ $c == ')' ]]; then ((depth > 0)) && depth=$((depth - 1)); ((i++)); continue
    elif [[ ${s:i:2} == '[[' ]]; then bdepth=$((bdepth + 1)); ((i += 2)); continue
    elif [[ ${s:i:2} == ']]' ]]; then ((bdepth > 0)) && bdepth=$((bdepth - 1)); ((i += 2)); continue
    elif ((depth || bdepth)); then ((i++)); continue
    fi
    # fd-prefixed redirect (2>, 2>>, 2>&1) — only at a word boundary, so `chmod 644 f` is safe
    fd=""
    if [[ $c == [0-9] && ( ${s:i+1:1} == '>' || ${s:i+1:1} == '<' ) ]] && { ((i == 0)) || [[ ${s:i-1:1} == ' ' ]]; }; then
      fd=$c; ((i++)); c=${s:i:1}
    fi
    t=""
    case $c in
      '>')
        if [[ ${s:i+1:1} == '&' ]]; then
          tgt=""; ((i += 2))
          while ((i < n)) && [[ ${s:i:1} == [0-9-] ]]; do tgt+=${s:i:1}; ((i++)); done
          if [[ -n $tgt ]]; then t="${fd:-1}>&${tgt}"          # dup: 2>&1, >&2 == 1>&2
          else t='> 2>&1'; fi                                  # >&file == &>file
        elif [[ ${s:i+1:1} == '>' ]]; then
          ((i += 2)); [[ $fd == 2 ]] && t='2>>' || t='>>'
          [[ -n $fd && $fd != 1 && $fd != 2 ]] && t="${fd}>>"
        else
          ((i++)); [[ $fd == 2 ]] && t='2>' || t='>'
          [[ -n $fd && $fd != 1 && $fd != 2 ]] && t="${fd}>"
        fi ;;
      '<')
        if [[ ${s:i+1:2} == '<<' ]]; then t='<<<'; ((i += 3))
        elif [[ ${s:i+1:1} == '<' ]]; then t='<<'; ((i += 2))
        else t='<'; ((i++)); fi ;;
      '&')
        if [[ ${s:i+1:1} == '&' ]]; then t='&&'; ((i += 2))
        elif [[ ${s:i+1:2} == '>>' ]]; then t='>> 2>&1'; ((i += 3))
        elif [[ ${s:i+1:1} == '>' ]]; then t='> 2>&1'; ((i += 2))
        else t='&'; ((i++)); fi ;;
      '|')
        if [[ ${s:i+1:1} == '|' ]]; then t='||'; ((i += 2))
        elif [[ ${s:i+1:1} == '&' ]]; then t='2>&1 |'; ((i += 2))
        else t='|'; ((i++)); fi ;;
      ';') t=';'; ((i++)) ;;
      *) ((i++)) ;;
    esac
    if [[ -n $t ]]; then
      [[ $t == "$prev" ]] || { [[ -n $out ]] && out+=" "; out+="$t"; }
      prev=$t
    fi
  done
  REPLY=$out
}

# Sandbox equivalence may only rescue an answer whose operator skeleton matches an
# accepted one. A fresh sandbox can't tell `ls >> f` from `ls > f` (file didn't exist)
# or `a ; b` from `a && b` (nothing fails) — but those are exactly the near-misses of
# the command being taught. Alternates listed with different operators are compared
# against their OWN skeleton, so they keep passing.
_skel_ok() {
  local inp=$1 answers=$2 delim=$3 a b lit=0
  _opskel "$inp"; local uskel=$REPLY
  local -a opts; IFS="$delim" read -ra opts <<< "$answers"
  for a in "${opts[@]}"; do
    _trim "$a"; b=$REPLY
    [[ -z "$b" || "$b" == ~* ]] && continue   # regex alternates have no literal skeleton
    lit=1
    _opskel "$b"; [[ "$REPLY" == "$uskel" ]] && return 0
  done
  ((lit)) || return 0   # nothing literal to compare against — don't block the sandbox
  return 1
}

_text_match() {
  local inp=$1 ninp=$2 answers=$3 delim=$4 a b
  local -a opts; IFS="$delim" read -ra opts <<< "$answers"
  for a in "${opts[@]}"; do
    _trim "$a"; b=$REPLY
    [[ -z "$b" ]] && continue
    if [[ "$b" == ~* ]]; then
      local _pat="${b:1}"; [[ "$inp" =~ ${_pat} ]] && return 0
    else
      _fnorm "$b"; [[ "$inp" == "$b" || "$ninp" == "$REPLY" ]] && return 0
    fi
  done; return 1
}

check() {
  _trim "$1"; local inp=$REPLY; _fnorm "$inp"; local ninp=$REPLY
  _SANDBOX_REQUIRE_FAIL=0
  ((SANDBOX_MODE && !_qtext)) && _skel_ok "$inp" "$2" "$_qdelim" && _sandbox_validate "$inp" && return 0
  [[ -n "${_qrequire:-}" && "${inp// /}" != *"${_qrequire// /}"* ]] && return 1  # whitespace-insensitive (see _sandbox_validate)
  _text_match "$inp" "$ninp" "$2" "$_qdelim"
}

_show_alts() {
  ((OPT_ALTS)) || return 0
  local inp=$1 answers=$2 delim=$3
  _fnorm "$inp"; local ninp=$REPLY
  local -a opts shown=()
  IFS="$delim" read -ra opts <<< "$answers"
  local a b max=3
  for a in "${opts[@]}"; do
    _trim "$a"; b=$REPLY
    [[ -z "$b" || "$b" == ~* ]] && continue
    _fnorm "$b"
    [[ "$inp" == "$b" || "$ninp" == "$REPLY" ]] && continue
    shown+=("$b")
    ((${#shown[@]} >= max)) && break
  done
  ((${#shown[@]})) || return 0
  printf '  %s\n' "${D}Also:${N}"
  local a; for a in "${shown[@]}"; do
    printf '    %s\n' "${D}$a${N}"
  done
}

LVL=1 QI=0 TOT=0
load() {
  [[ -f "$DATA/session.json" ]] && {
    local fd t; exec {fd}<>"$DATA/session.lock"; flock -s "$fd"
    t=$(<"$DATA/session.json")
    exec {fd}>&-
    LVL="${t#*\"level\":}"; LVL="${LVL%%[!0-9]*}"
    [[ "$t" == *'"qi":'* ]] && { QI="${t#*\"qi\":}"; QI="${QI%%[!0-9]*}"; }
  }
  LVL=${LVL:-1}; QI=${QI:-0}
  ((LVL < 1)) && LVL=1  # migrate old 0-indexed sessions
  ((LVL > MAX_LEVEL)) && LVL=$MAX_LEVEL
}
save() {
  local fd; exec {fd}>"$DATA/session.lock"; flock -x "$fd"
  printf '{"level":%d,"qi":%d}\n' "$LVL" "$QI" > "$DATA/session.json.tmp"
  mv "$DATA/session.json.tmp" "$DATA/session.json"
  exec {fd}>&-
}
# ═══ SCORING & UI ═══
declare -A _HASH_CACHE=()
_hash() {
  local key="$1"
  if [[ -n "${_HASH_CACHE[$key]:-}" ]]; then REPLY="${_HASH_CACHE[$key]}"; return; fi
  local h=5381 i c
  for ((i=0; i<${#key}; i++)); do
    printf -v c '%d' "'${key:i:1}"
    h=$(( ((h << 5) + h + c) & 0xFFFFFFFF ))
  done
  printf -v REPLY '%08x' "$h"
  _HASH_CACHE[$key]="$REPLY"
}
norm() {
  local -n _arr=$1; local i j tmp
  for ((i=1; i<${#_arr[@]}; i++)); do
    tmp="${_arr[$i]}"; j=$i
    while ((j > 0)) && [[ "${_arr[$((j-1))]}" > "$tmp" ]]; do
      _arr[$j]="${_arr[$((j-1))]}"; ((j--))
    done
    _arr[$j]="$tmp"
  done
}
_sflush() {
  # Best-effort advisory lock. If the data dir is unwritable (disk full, ro mount)
  # the open fails — fall back to a lockless write rather than crashing under set -u
  # and losing the session's scores.
  local _fd=""
  # NB: brace-group scopes the 2>/dev/null to just this open — a bare
  # `exec ... 2>/dev/null` would redirect the whole game's stderr permanently
  # (exec with no command makes redirections stick), silently eating every
  # later `read -p` prompt so the game looks frozen at the next _pause.
  { exec {_fd}>"$DATA/scores.lock"; } 2>/dev/null && flock -x "$_fd"
  # Merge with current disk state to survive concurrent instances: for shared
  # keys, keep whichever has the later timestamp.
  local -A _disk_sc=()
  local _dk _dv _dt _mt _k _nowf; printf -v _nowf '%(%s)T' -1
  if [[ -f "$DATA/scores" ]]; then
    while IFS='|' read -r _dk _dv; do
      [[ "$_dk" == "#"* || -z "$_dk" ]] && continue
      _disk_sc[$_dk]=$_dv
    done < "$DATA/scores"
  fi
  for _k in "${!_disk_sc[@]}"; do
    if [[ -n "${_sc[$_k]:-}" ]]; then
      _dt="${_disk_sc[$_k]##*|}"; _mt="${_sc[$_k]##*|}"
      if [[ "$_dt" =~ ^[0-9]+$ && "$_mt" =~ ^[0-9]+$ ]]; then
        # A future disk ts (clock skew) would win every merge forever, silently
        # shadowing real progress — treat it as invalid and prefer memory.
        if ((_dt > _mt && _dt <= _nowf)); then _sc[$_k]="${_disk_sc[$_k]}"
        elif ((_dt == _mt)); then
          # Same-second tie between two concurrent instances: strict > kept whoever
          # flushed last, silently downgrading the other's progress. Prefer the higher
          # tier so real advancement is never lost on a 1s-resolution collision.
          local _dtr="${_disk_sc[$_k]%%|*}" _mtr="${_sc[$_k]%%|*}"
          [[ "$_dtr" =~ ^[0-9]+$ && "$_mtr" =~ ^[0-9]+$ ]] && ((10#$_dtr > 10#$_mtr)) && _sc[$_k]="${_disk_sc[$_k]}"
        fi
      fi
    else
      # Skip keys this instance pruned (stale tier-0) — re-adding them from disk
      # would make the prune a no-op and the scores file grow forever.
      [[ -n "${_sc_del[$_k]:-}" ]] || _sc[$_k]="${_disk_sc[$_k]}"
    fi
  done
  # Only replace the live file if the whole payload wrote — a failed printf (ENOSPC)
  # makes the group's status nonzero, so a truncated tmp can never clobber good scores.
  { printf '#v1\n'; for _k in "${!_sc[@]}"; do printf '%s|%s\n' "$_k" "${_sc[$_k]}"; done; } > "$DATA/scores.tmp" \
    && mv "$DATA/scores.tmp" "$DATA/scores" || rm -f "$DATA/scores.tmp"
  [[ -n "$_fd" ]] && exec {_fd}>&-
}

_calc_mastery() {
  local -n _src=$1; _cm_seen=0 _cm_t1=0 _cm_t2=0 _cm_tagged=0
  for k in "${!_src[@]}"; do
    local _val="${_src[$k]}" _tier _lvtag
    _tier="${_val%%|*}"
    if [[ "$_val" == *"|"* ]]; then _lvtag="${_val#*|}"; _lvtag="${_lvtag%%|*}"; _cm_tagged=1
    else _lvtag=""; fi
    # mastered = a valid tier >=2; a corrupt/out-of-range tier must NOT read as mastery
    # (would paint a level green/✓ off garbage) — bucket it as learning, matching _sget.
    if [[ "$_tier" =~ ^[0-9]+$ ]] && ((10#$_tier >= 2)); then ((_cm_t2++)); else ((_cm_t1++)); fi
    ((_cm_seen++))
    [[ -n "$_lvtag" ]] && {
      lv_total[$_lvtag]=$(( ${lv_total[$_lvtag]:-0} + 1 ))
      [[ "$_tier" =~ ^[0-9]+$ ]] && ((10#$_tier >= 2)) && lv_mastered[$_lvtag]=$(( ${lv_mastered[$_lvtag]:-0} + 1 ))
    }
  done
}

stats() {
  local -A sc; [[ -f "$DATA/scores" ]] && while IFS='|' read -r k v; do [[ "$k" == "#"* || -z "$k" ]] && continue; sc[$k]=$v; done < "$DATA/scores"
  printf '%s\n' "${W}${B}${PLAYER_NAME:-anon}${N}"
  printf '%s\n\n' "${D}Stats show unique prompts seen${N}"
  local -A lv_total lv_mastered; _calc_mastery sc
  printf 'Total: %s  %s learning  %s mastered\n\n' "${B}${_cm_seen}${N}" "${Y}${_cm_t1}${N}" "${G}${_cm_t2}${N}"
  local BAR_W=10
  for lv in {1..30}; do
    local lt=${lv_total[$lv]:-0} lm=${lv_mastered[$lv]:-0}
    local boss_mark=""
    if ((lv <= BOSS_BEATEN)); then
      ((lv <= PLACED_THROUGH)) && boss_mark="${C}p${N}" || boss_mark="${G}+${N}"
    else boss_mark="${D}·${N}"; fi
    if ((lt > 0)); then
      local pct=$((lm * 100 / lt)) filled=$((lm * BAR_W / lt)); local empty=$((BAR_W - filled))
      local bar_f bar_e; printf -v bar_f '%*s' "$filled" ''; printf -v bar_e '%*s' "$empty" ''
      local col sym
      if ((pct >= 80)); then col=$G; sym="✓"
      elif ((pct >= 40)); then col=$Y; sym="~"
      else col=$R; sym="x"; fi
      printf "  %s ${U}%2d${N} %-22s ${col}%s${D}%s${N} ${col}%s${N} %3d%% (%d/%d)\n" "$boss_mark" "$lv" "${LEVEL_NAMES[$lv]:-}" "${bar_f// /█}" "${bar_e// /░}" "$sym" "$pct" "$lm" "$lt"
    else
      printf "  %s ${U}%2d${N} %-22s ${D}%*s${N}\n" "$boss_mark" "$lv" "${LEVEL_NAMES[$lv]:-}" "$BAR_W" "no data"
    fi
  done
  _csv_count "$SC_DONE"; local sc_count=$REPLY
  ((SC_TOTAL > 0)) && printf '\n  %s %s/%d\n' "${U}Scenarios:${N}" "${M}${B}${sc_count}${N}" "$SC_TOTAL"
  _csv_count "$DISKS_FOUND"; local disk_count=$REPLY
  printf '  %s %s/%d\n' "${U}Floppy Disks:${N}" "${Y}${disk_count}${N}" "$_DISK_TOTAL"
  if ((BOSS_BEATEN >= MAX_LEVEL)); then
    printf '\n  %s\n' "${U}Records${N}"
    if ((BEST_CHALLENGE > 0)); then
      printf '  %s %s\n' "${U}Challenge:${N}" "${Y}${BEST_CHALLENGE}${N}"
    else
      printf '  %s\n' "${D}no records yet — beat challenge to set one${N}"
    fi
  fi
}

_S_ANSWERED=0 _S_CORRECT=0 _S_STREAK=0 _S_BEST_STREAK=0 _S_MASTERED=0 _S_START=0
declare -A _S_PROMOTED=()  # prompt-hash → 1, prevents double-promote within a session
_session_init() { printf -v _S_START '%(%s)T' -1; _S_ANSWERED=0 _S_CORRECT=0 _S_STREAK=0 _S_BEST_STREAK=0 _S_MASTERED=0; _S_PROMOTED=(); _disk_check nightowl; }
_QUIT=0
_quit() {
  _sflush_if_dirty
  printf '\n'
  if ((_S_ANSWERED > 0)); then
    local _ts; printf -v _ts '%(%s)T' -1; local elapsed=$((_ts - _S_START))
    local m=$((elapsed / 60)) s=$((elapsed % 60))
    printf '%s\n%s\n  %s    %s\n' "${U}Session Summary${N}" "${D}----------------------------------------${N}" "${U}Answered:${N}" "${B}${_S_ANSWERED}${N}"
    printf '  %s     %s' "${U}Correct:${N}" "${G}${_S_CORRECT}${N}"
    ((_S_ANSWERED > 0)) && printf ' (%d%%)' $((_S_CORRECT * 100 / _S_ANSWERED))
    printf '\n  %s %s\n' "${U}Best streak:${N}" "${W}${B}${_S_BEST_STREAK}${N}"
    ((_S_MASTERED > 0)) && printf '  %s    %s\n' "${U}Mastered:${N}" "${G}${_S_MASTERED}${N}"
    printf '  %s        %dm %ds\n%s\n' "${U}Time:${N}" "$m" "$s" "${D}----------------------------------------${N}"
    read -rsp "${D}Press Enter to continue...${N}"; echo
  fi
  _QUIT=1
}

