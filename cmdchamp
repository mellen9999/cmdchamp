  # else the blind old read treated F9 as a paste start and swallowed typing.
  read -rsn1 -t 0.05 _p || _p=""
  [[ "$_p" != "0" ]] && { [[ "$_p" != "~" ]] && _csi_drain; return 1; }  # \e[20~ (F9) or other CSI
