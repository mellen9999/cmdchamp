SANDBOX_DIR="$DATA/sandbox"
_SANDBOX_GEN=3  # fixture generation — bump to force a pristine rebuild on existing installs

_BWRAP_FLAG="$DATA/.bwrap_blocked"
_bwrap_notice() {
  local _kind=$1 _raw=${2:-}
  printf '\n%s\n\n' "${Y}${B}Sandbox unavailable — running in text-match mode${N}" >&2
  case $_kind in
    missing)
      printf '%s\n' "${C}bubblewrap${N} (bwrap) isn't installed. cmdchamp will still match" >&2
      printf '%s\n\n' "answers as text, just without isolated execution." >&2
      printf '%s\n' "${C}Install:${N}" >&2
      printf '  %s    %s\n'   "${G}paru -S bubblewrap${N}"        "${D}# Arch / CachyOS${N}" >&2
      printf '  %s    %s\n\n' "${G}sudo apt install bubblewrap${N}" "${D}# Debian / Ubuntu${N}" >&2
      ;;
    blocked)
      printf '%s\n' "Your kernel disallows unprivileged user namespaces, which the sandbox" >&2
      printf '%s\n\n' "needs. cmdchamp will still match answers as text." >&2
      printf '%s\n' "${C}Enable the sandbox:${N}" >&2
      printf '  %s\n'   "${G}sudo sysctl -w kernel.unprivileged_userns_clone=1${N}" >&2
      printf '  %s\n\n' "${G}echo kernel.unprivileged_userns_clone=1 | sudo tee /etc/sysctl.d/99-cmdchamp.conf${N}" >&2
      [[ -n "$_raw" ]] && printf '%s %s\n\n' "${D}bwrap:${N}" "${D}${_raw%%$'\n'*}${N}" >&2
      ;;
  esac
  printf '%s\n\n' "${D}(shown once; pass --no-sandbox to silence)${N}" >&2
  [[ -t 0 && -t 2 ]] && _pause >&2 ||:
}

_check_bwrap() {
  if ! command -v bwrap &>/dev/null; then
    SANDBOX_MODE=0
    [[ -f "$_BWRAP_FLAG" ]] || { _bwrap_notice missing; : > "$_BWRAP_FLAG"; }
    return 1
  fi
  local _err
  if ! _err=$(bwrap --dev-bind / / --unshare-all true 2>&1); then
    SANDBOX_MODE=0
    [[ -f "$_BWRAP_FLAG" ]] || { _bwrap_notice blocked "$_err"; : > "$_BWRAP_FLAG"; }
    return 1
  fi
  [[ -f "$_BWRAP_FLAG" ]] && rm -f "$_BWRAP_FLAG"
  return 0
}

# shellcheck disable=SC2034  # locals used via _fpick nameref
_gen_log() {
  local f="$1" lines="${2:-50}"
  ((lines > 0)) || lines=1
  local ips=("192.168.1.100" "10.0.0.5" "172.16.0.50" "192.168.8.1" "10.10.10.10")
  local codes=("200" "200" "200" "200" "301" "304" "400" "403" "404" "500")
  local methods=("GET" "GET" "GET" "POST" "PUT" "DELETE")
  local paths=("/" "/index.html" "/api/users" "/api/data" "/login" "/static/style.css" "/favicon.ico" "/admin" "/search" "/api/v1/status")
  local agents=("Mozilla/5.0" "curl/7.68" "wget" "Python-requests" "Go-http-client")
  local now; printf -v now '%(%s)T' -1
  local step=$((86400 / lines))
  : > "$f"
  # Guarantee every searchable method/code (see gen_level5 term pool) appears
  local fmeths=("GET" "POST") fcodes=("200" "404" "500")
  for ((i=0; i<lines; i++)); do
    _fpick ips; local ip=$REPLY
    local code method
    if ((i < 3)); then code=${fcodes[$i]}; else _fpick codes; code=$REPLY; fi
    if ((i < 2)); then method=${fmeths[$i]}; else _fpick methods; method=$REPLY; fi
    _fpick paths; local path=$REPLY
    _fpick agents; local agent=$REPLY; local size=$((RANDOM % 50000 + 100))
    local ts; printf -v ts '%(%d/%b/%Y:%H:%M:%S +0000)T' "$((now - (lines - i) * step + RANDOM % step))"
    printf '%s - - [%s] "%s %s HTTP/1.1" %s %d "%s"\n' "$ip" "$ts" "$method" "$path" "$code" "$size" "$agent"
  done >> "$f"
}

# shellcheck disable=SC2034  # locals used via _fpick nameref
_gen_app_log() {
  local f="$1" lines="${2:-40}"
  ((lines > 0)) || lines=1
  local levels=("INFO" "INFO" "INFO" "INFO" "WARN" "WARN" "ERROR" "DEBUG")
  local msgs_info=("Request processed" "User logged in" "Cache hit" "Connection established" "Task completed" "Session started")
  local msgs_warn=("Slow query detected" "Memory usage high" "Rate limit approaching" "Deprecated API used" "Retry attempt")
  local msgs_error=("Connection refused" "Timeout exceeded" "Invalid request" "Permission denied" "Database error" "Null pointer")
  local now; printf -v now '%(%s)T' -1
  local step=$((86400 / lines))
  : > "$f"
  # Guarantee at least one of each level in first 4 lines
  local forced=("INFO" "WARN" "ERROR" "DEBUG")
  for ((i=0; i<lines; i++)); do
    local level
    if ((i < 4)); then level=${forced[$i]}; else _fpick levels; level=$REPLY; fi
    local ts; printf -v ts '%(%Y-%m-%d %H:%M:%S)T' "$((now - (lines - i) * step + RANDOM % step))"
    local msg
    case "$level" in
      INFO|DEBUG) _fpick msgs_info; msg=$REPLY;;
      WARN) _fpick msgs_warn; msg=$REPLY;;
      ERROR) _fpick msgs_error; msg=$REPLY;;
    esac
    printf '[%s] %s: %s\n' "$ts" "$level" "$msg"
  done >> "$f"
}

