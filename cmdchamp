_rl_rem() { local _n; printf -v _n '%(%s)T' -1; REPLY=$((_rl_deadline - _n)); ((REPLY < 0)) && REPLY=0; }

# Countdown tick: only the header digits change, so never touch the prompt
# line — save cursor, rewrite header (line-clears only, no \e[J), restore.
# Blink-proof even where DEC 2026 isn't honored (tmux passthrough is spotty).
_rl_tick() { printf '\e[?25l\e7'; _REDRAW_HDR; printf '\e8\e[?25h'; }

# $1: allow manpages  $2: allow history  $3: timeout (0=none, returns 1 on timeout)
# Caller defines _REDRAW_HDR(). Uses dynamic scoping for ans, HIST, etc.
_read_line() {
  local _rl_hints=${1:-1} _rl_hist=${2:-1} _rl_timeout=${3:-0} _rl_deadline=0 _rc=0
