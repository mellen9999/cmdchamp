# ═══ SCENARIO ENGINE ═══

_perms_restore() { while IFS=' ' read -r _pmode _ppath; do [[ -n "$_ppath" ]] && chmod "$_pmode" "$_ppath" 2>/dev/null; done < "$1"; }
# Uses dynamic-scoped _sc_snap, _perms_file from scenario()
_sc_snap_save() {
  find "$SANDBOX_DIR" -printf '%m %p\n' > "$_perms_file" 2>/dev/null
  chmod -R u+rwX "$SANDBOX_DIR" 2>/dev/null
  # On any failure, drop the stale snapshot (so _sc_snap_restore falls back to
  # pristine) AND restore perms — bailing after the chmod above would leave the
  # sandbox permission-boosted and silently break permission-state grading.
  local _t; _t=$(mktemp -d "${_sc_snap}.XXXXXX") || { rm -rf "$_sc_snap"; _perms_restore "$_perms_file"; return; }
  # Copy INTO existing temp dir (no rm-then-cp TOCTOU window).
  if cp -a "$SANDBOX_DIR/." "$_t/"; then
    rm -rf "$_sc_snap"; mv "$_t" "$_sc_snap"
  else
    rm -rf "$_t" "$_sc_snap"
  fi
  _perms_restore "$_perms_file"
}
_sc_snap_restore() {
  # If the snapshot is missing (save failed) or a temp dir can't be made, reset to
  # pristine instead of leaving the corrupted post-answer state for the retry.
  [[ -d "$_sc_snap" ]] || { _sandbox_reset; return; }
  chmod -R u+rwX "$SANDBOX_DIR" 2>/dev/null
  local _t; _t=$(mktemp -d "${SANDBOX_DIR}.XXXXXX") || { _sandbox_reset; return; }
  if cp -a "$_sc_snap/." "$_t/"; then
    rm -rf "$SANDBOX_DIR"; mv "$_t" "$SANDBOX_DIR"
  else
    rm -rf "$_t"
  fi
  _perms_restore "$_perms_file"
}
scenario() {
  local sc_id=${1:-0}
  ((sc_id == 0)) && { _sc_sel; return; }
  ((sc_id < 1 || sc_id > SC_TOTAL)) && { printf '%s\n' "${R}Scenario ${sc_id} does not exist.${N}"; return 1; }
  local _sc_req=${SC_UNLOCK[$sc_id]:-$MAX_LEVEL}
  if ((BOSS_BEATEN < _sc_req)); then
    printf '%s\n' "${R}Locked${N} — beat the ${U}Level ${_sc_req}${N} boss (${M}${B}${LEVEL_NAMES[$_sc_req]}${N}) first."
    return 1
  fi
  if ! ((SANDBOX_MODE)); then
    printf '%s\n' "${R}Scenarios require sandbox mode.${N}"; return 1
  fi
  _session_init
  _mode_init "sc${sc_id}"

  # Fresh sandbox + apply broken state — abort loudly on failure rather than
  # letting text-match fallback fake a completable scenario over broken state
  if ! _sandbox_reset || ! "_sc_setup_${sc_id}" "$SANDBOX_DIR"; then
    printf '%s\n' "${R}scenario setup failed${N} ${D}— check required tools (e.g. git) are installed${N}"
    return 1
  fi

  # Load steps
  local -a steps=()
  while IFS= read -r line; do [[ -n "$line" ]] && steps+=("$line"); done <<< "$("_sc_steps_${sc_id}")"
  local total=${#steps[@]} correct=0

  # Splash screen
  printf '%s\e[2J\e[H' "$_SY"
  printf '%s\n' "${M}${B}═══ ${SC_NAMES[$sc_id]} ═══${N}"
  printf '%s\n' "${D}${SC_FLAVOR[$sc_id]}${N}"
  printf '%s\n\n' "${U}${total} steps${N} ${D}— sandbox state persists between steps${N}"
  printf '%s' "$_SN"
  read -rsp "${D}Press Enter to start...${N}"; echo

  local si _sc_snap="$DATA/sandbox.snap"
  for ((si=0; si<total; si++)); do
    _qparse "${steps[$si]}"
    local prompt=$_qprompt ans=$_qans

    local _perms_file="$_sc_snap.perms"
    _sc_snap_save

    _REDRAW_HDR() {
      printf '%s\e[H%s  %s\e[K\n\e[K\n%s\e[K\n\e[K\n\e[J%s' "$_SY" "${M}${B}${SC_NAMES[$sc_id]}${N}" "${U}[Step $((si+1))/${total}]${N}" "${C}${prompt}${N}" "$_SN"
    }
    printf '\e[2J'; _REDRAW_HDR
    HIST=()

    while true; do
      _read_line 1 1
      ((_QUIT)) && break
      [[ -z "$input" ]] && { draw; continue; }
      if check "$input" "$_qanswers"; then
        _sc; _disk_check streak; ((++correct))
        printf '\n%s\n' "${G}${B}+${N}"
        _pause
        break
      elif ((_SANDBOX_REQUIRE_FAIL == 2)); then
        printf '\n%s\n' "${Y}right command — use the exact string from the question${N}"
        sleep 1; printf '\e[2J'; _REDRAW_HDR; continue
      else
        [[ -n "$input" ]] && { HIST+=("$input"); HIST_IDX=${#HIST[@]}; HIST_SAVE=""; }
        ((_S_ANSWERED++)); _S_STREAK=0; _wrong_show; _disk_check wrong "$input"
        explain "$ans"
        _sc_snap_restore
        _pause retry
        printf '\e[2J'; _REDRAW_HDR
      fi
    done
    ((_QUIT)) && break
  done
  rm -rf "$_sc_snap" "$_sc_snap.perms" 2>/dev/null
  if ((_QUIT)); then _sflush_if_dirty; return; fi
  # Completion
  printf '%s\e[2J\e[H' "$_SY"
  printf '%s\n' "${G}${B}═══ SCENARIO COMPLETE ═══${N}"
  printf '%s\n' "${M}${B}${SC_NAMES[$sc_id]}${N}"
  printf '%s\n' "${G}${correct}/${total}${N} steps"
  printf '%s' "$_SN"
  _sc_mark_done "$sc_id"
  _disk_check completionist
  _sflush_if_dirty
  _pause  # the menu's next draw clears the screen — hold the completion screen
  echo
}

# ═══ SELFTEST ═══
_selftest() {
  local _pass=0 _fail=0 _t
  _assert() {
    local desc=$1 got=$2 want=$3
    if [[ "$got" == "$want" ]]; then ((_pass++))
    else ((_fail++)); printf '  FAIL: %s\n    got:  %s\n    want: %s\n' "$desc" "$got" "$want"; fi
  }
  _assert_match() {
    local desc=$1 got=$2 pat=$3
    if [[ "$got" =~ $pat ]]; then ((_pass++))
    else ((_fail++)); printf '  FAIL: %s\n    got:  %s\n    want: ~%s\n' "$desc" "$got" "$pat"; fi
  }

  printf '%s\n' "${B}=== _fnorm ===${N}"
  local -a _ft=(
    $'identity\tls\tls'
    $'trim\t  ls -l  \tls -l'
    $'flag sort\tls -l -a\tls -a -l'
    $'combined split\tls -la\tls -a -l'
    $'single quotes\tgrep \'foo\' bar\tgrep foo bar'
    $'double quotes\tgrep "foo" bar\tgrep foo bar'
    $'flag quote strip\tawk -F\',\'\tawk -F,'
    $'redirect split\techo hi >out\techo hi > out'
    $'stderr redirect\tcmd 2>/dev/null\tcmd 2> /dev/null'
    $'pipe\tcat f | grep x\tcat f | grep x'
    $'pipe no space\tcat f|grep x\tcat f | grep x'
    $'dotslash\tls ./foo\tls foo'
    $'head -N\thead -5 file\thead -n 5 file'
    $'tail -N\ttail -20 log\ttail -n 20 log'
    $'head --lines\thead --lines file\thead -n file'
    $'long=val\tsort --field-separator=,\tsort --field-separator=,'
    $'-n5 split\thead -n5 f\thead -n 5 f'
    $'-t, split\tsort -t, file\tsort -t, file'
    $'-F: split\tawk -F: prog file\tawk -F: prog file'
    $'-d/ split\tcut -d/ -f1\tcut -d/ -f1'
    $'dashdash\tgrep -- -v file\tgrep -- -v file'
    $'semicolon\tcmd1; cmd2\tcmd1 ; cmd2'
    $'semicolon glued\tcmd1;cmd2\tcmd1 ; cmd2'
    $'semicolon triple glued\ta;b;c\ta ; b ; c'
    $'find exec semi intact\tfind . -exec rm {} \\;\tfind -c -e -e -x . rm {} \\;'
    $'empty\t\t'
    $'double pipe\tcmd1 || cmd2\tcmd1 || cmd2'
    $'complex\tgrep -rn \'TODO\' ./src\tgrep -n -r TODO src'
    $'awk -F:\tawk -F: \'{print $1}\' /etc/passwd\tawk -F: \'{print $1}\' /etc/passwd'
    $'append redirect\techo hi >>out\techo hi >> out'
    $'multi args\tcp a b c\tcp a b c'
    $'tail +N\ttail -n +5 file\ttail -n +5 file'
    $'tar bundle sort\ttar xzf a.tar.gz\ttar fxz a.tar.gz'
    $'tar bundle sort2\ttar czf a.tar.gz dir\ttar cfz a.tar.gz dir'
    $'cut pair order A\tcut -d: -f1 /etc/passwd\tcut -d: -f1 /etc/passwd'
    $'cut pair order B\tcut -f1 -d: /etc/passwd\tcut -d: -f1 /etc/passwd'
    $'cut pair spaced\tcut -d : -f 1 /etc/passwd\tcut -d: -f1 /etc/passwd'
    $'cut long pair\tcut --delimiter=, --fields=1 f\tcut --delimiter=, --fields=1 f'
    $'cut long pair reorder\tcut --fields=1 --delimiter=, f\tcut --delimiter=, --fields=1 f'
    # Statement separators: each segment normalizes on its own, so a flag can never hoist
    # across a boundary, and && / || / ; stay distinct from one another.
    $'&& keeps flags in segment\tgrep x f > t && mv -v t f\tgrep x f > t && mv -v t f'
    $'&& no flag hoist\tls -l && ls -a\tls -l && ls -a'
    $'|| separator kept\tmkdir d || echo fail\tmkdir d || echo fail'
    $'; separator kept\tcd /tmp ; ls -la\tcd /tmp ; ls -a -l'
    $'find -exec \\; not a separator\tfind . -name x -exec rm {} \\;\tfind -a -c -e -e -e -m -n -x . x rm {} \\;'
  )
  for _t in "${_ft[@]}"; do IFS=$'\t' read -r _d _i _w <<< "$_t"; _fnorm "$_i"; _assert "$_d" "$REPLY" "$_w"; done
  # A flag hoisting across && would make these two collide — they must stay distinct.
  _fnorm 'grep x f > t && mv -v t f'; local _sep_a=$REPLY
  _fnorm 'grep -v x f > t && mv t f'; local _sep_eq=1; [[ "$REPLY" != "$_sep_a" ]] && _sep_eq=0
  _assert "&& segments do not share flags" "$_sep_eq" "0"
  _fnorm 'a && b'; _sep_a=$REPLY
  _fnorm 'a ; b'; _sep_eq=1; [[ "$REPLY" != "$_sep_a" ]] && _sep_eq=0
  _assert "&& is not equivalent to ;" "$_sep_eq" "0"

  printf '%s\n' "${B}=== _hash ===${N}"
  _hash "test123"; local h1=$REPLY
  _hash "test123"; _assert "deterministic" "$REPLY" "$h1"
  _assert_match "hex format" "$h1" '^[0-9a-f]{8}$'
  _hash "test124"; local _diff_rc=1; [[ "$REPLY" != "$h1" ]] && _diff_rc=0; _assert "different input" "$_diff_rc" "0"
  _assert "cached" "${_HASH_CACHE[test123]}" "$h1"

  printf '%s\n' "${B}=== norm ===${N}"
  local -a _ta=(c a b d)
  norm _ta; _assert "sort" "${_ta[*]}" "a b c d"
  local -a _tb=(z)
  norm _tb; _assert "single" "${_tb[*]}" "z"
  local -a _tc=()
  norm _tc; _assert "empty" "${_tc[*]}" ""
  local -a _td=(b a c a)
  norm _td; _assert "dupes" "${_td[*]}" "a a b c"

  printf '%s\n' "${B}=== check (text match) ===${N}"
  local _save_sandbox=$SANDBOX_MODE; SANDBOX_MODE=0
  _qdelim='|' _qtext=0 _qoutput="" _qstate=""
  check "pwd" "pwd" && _t=0 || _t=$?; _assert "exact" "$_t" "0"
  check "ls -la" "ls -la|ls -al" && _t=0 || _t=$?; _assert "multi answer" "$_t" "0"
  check "  pwd  " "pwd" && _t=0 || _t=$?; _assert "trim input" "$_t" "0"
  check "ls -al" "ls -la" && _t=0 || _t=$?; _assert "normalized" "$_t" "0"
  check "wrong" "pwd" && _t=0 || _t=$?; _assert "wrong answer" "$_t" "1"
  check "ls /tmp/foo" '~^ls /tmp/' && _t=0 || _t=$?; _assert "regex match" "$_t" "0"
  check "cat /etc" '~^ls /tmp/' && _t=0 || _t=$?; _assert "regex no match" "$_t" "1"
  # Regression: anchored regexes must reject trailing appended commands (false-accept guard)
  check "git bisect start && rm -rf /" '~^git bisect start$' && _t=0 || _t=$?; _assert "regex append rejected" "$_t" "1"
  check "git bisect start" '~^git bisect start$' && _t=0 || _t=$?; _assert "regex anchored ok" "$_t" "0"
  check "git tag v1 && rm -rf ~" '~^git tag v[0-9][^ ]*$' && _t=0 || _t=$?; _assert "regex tail append rejected" "$_t" "1"
  check "git tag v1.2.3" '~^git tag v[0-9][^ ]*$' && _t=0 || _t=$?; _assert "regex versioned tail ok" "$_t" "0"
  _qdelim='§'
  check "grep foo bar" 'grep foo bar§cat bar | grep foo' && _t=0 || _t=$?; _assert "§ delim" "$_t" "0"
  check "cat f | grep x" 'cat f | grep x' && _t=0 || _t=$?; _assert "valid pipe ok" "$_t" "0"
  check "| sort foo" 'sort foo' && _t=0 || _t=$?; _assert "leading pipe rejected" "$_t" "1"
  _qdelim='|'
  SANDBOX_MODE=$_save_sandbox

  printf '%s\n' "${B}=== operator skeleton ===${N}"
  _opskel "ls"; _assert "skel none" "$REPLY" ""
  _opskel "ls > list.txt"; _assert "skel >" "$REPLY" ">"
  _opskel "ls >> list.txt"; _assert "skel >>" "$REPLY" ">>"
  _opskel "sort < data.csv > sorted.csv"; _assert "skel < >" "$REPLY" "< >"
  _opskel "sort <<< data.csv > sorted.csv"; _assert "skel <<< >" "$REPLY" "<<< >"
  _opskel "wait && echo done"; _assert "skel &&" "$REPLY" "&&"
  _opskel "wait ; echo done"; _assert "skel ;" "$REPLY" ";"
  _opskel "./backup.sh & pid=\$! && wait \$pid"; _assert "skel & &&" "$REPLY" "& &&"
  _opskel "./deploy.sh 2>&1 | grep -i error"; _assert "skel 2>&1 |" "$REPLY" "2>&1 |"
  _opskel "./deploy.sh |& grep -i error"; _assert "skel |& == 2>&1 |" "$REPLY" "2>&1 |"
  _opskel "./deploy.sh &> out.log"; _assert "skel &>" "$REPLY" "> 2>&1"
  _opskel "./deploy.sh > out.log 2>&1"; _assert "skel > 2>&1" "$REPLY" "> 2>&1"
  _opskel "./deploy.sh 1> out.log 2>&1"; _assert "skel 1> == >" "$REPLY" "> 2>&1"
  _opskel "./deploy.sh >& out.log"; _assert "skel >&file == &>" "$REPLY" "> 2>&1"
  _opskel "echo failed >&2"; _assert "skel >&2 == 1>&2" "$REPLY" "1>&2"
  _opskel "ls -la > out 2> err"; _assert "skel > 2>" "$REPLY" "> 2>"
  _opskel "find . -name '*.py' -exec chmod +x {} \\;"; _assert "skel find \\; not ;" "$REPLY" ""
  _opskel "grep -rnE 'TODO|FIXME' . > report.txt"; _assert "skel quoted | ignored" "$REPLY" ">"
  _opskel "echo \"a > b\""; _assert "skel dquoted > ignored" "$REPLY" ""
  _opskel "(( num > 5 ))"; _assert "skel arith > ignored" "$REPLY" ""
  _opskel "[[ \$(wc -w < f) -gt 5 ]] && echo big"; _assert "skel nested < ignored" "$REPLY" "&&"
