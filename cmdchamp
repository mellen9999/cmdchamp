PLAYER_NAME="" BOSS_BEATEN=0 BEST_CHALLENGE=0 DISKS_FOUND="" SC_DONE=""
OPT_VI=1 OPT_SOUND=1 OPT_ALTS=1
_PROFILE_VER=5  # bump this when profile format changes; old profiles get reset
LAST_DECAY=0  # epoch of last decay check (persisted in profile)
PLACED_THROUGH=0  # highest level passed via placement test

_load_profile() {
  if [[ -f "$DATA/profile" ]]; then
    local _file_ver=0
    while IFS='=' read -r key val; do
      [[ "$key" =~ ^[A-Z_]+$ ]] || continue
      case "$key" in
        PLAYER_NAME) _strip_ansi "$val"; PLAYER_NAME="${REPLY:0:32}";;
        BOSS_BEATEN) BOSS_BEATEN="$val";;
        BEST_CHALLENGE|BEST_GAUNTLET) BEST_CHALLENGE="$val";;
        DISKS_FOUND|EGGS_FOUND) DISKS_FOUND="$val";;
        SC_DONE) SC_DONE="$val";;
        LAST_DECAY) LAST_DECAY="$val";;
        OPT_VI) OPT_VI="$val";;
        OPT_SOUND) OPT_SOUND="$val";;
        OPT_ALTS) OPT_ALTS="$val";;
        PLACED_THROUGH) PLACED_THROUGH="$val";;
        PROFILE_VER) _file_ver="$val";;
      esac
    done < "$DATA/profile"
    [[ "$_file_ver" =~ ^[0-9]+$ ]] || _file_ver=0  # corrupt version -> reset-with-backup path
    # Validate/clamp BEFORE any migration re-save below: an out-of-range but numeric
    # field (e.g. BOSS_BEATEN=999 from a manual edit) would otherwise be written under
    # the new PROFILE_VER and frozen on disk forever, since migration never re-fires.
    [[ "$BOSS_BEATEN" =~ ^[0-9]+$ ]] || BOSS_BEATEN=0
    ((BOSS_BEATEN > MAX_LEVEL)) && BOSS_BEATEN=$MAX_LEVEL
    [[ "$BEST_CHALLENGE" =~ ^[0-9]+$ ]] || BEST_CHALLENGE=0
    [[ "$LAST_DECAY" =~ ^[0-9]+$ ]] || LAST_DECAY=0
    [[ "$OPT_VI" =~ ^[01]$ ]] || OPT_VI=1
    [[ "$OPT_SOUND" =~ ^[01]$ ]] || OPT_SOUND=1
    [[ "$OPT_ALTS" =~ ^[01]$ ]] || OPT_ALTS=1
    [[ "$PLACED_THROUGH" =~ ^[0-9]+$ ]] || PLACED_THROUGH=0
    ((PLACED_THROUGH > MAX_LEVEL)) && PLACED_THROUGH=$MAX_LEVEL
    local _now_l; printf -v _now_l '%(%s)T' -1
    ((LAST_DECAY > _now_l)) && LAST_DECAY=0  # clock-skew guard: future timestamps would block decay forever
    if ((_file_ver >= 2 && _file_ver < _PROFILE_VER)); then
      # Graceful migration: re-save in current format. Defaults already loaded
      # for any new fields the old profile didn't set.
      _save_profile
    elif ((_file_ver != _PROFILE_VER)); then
      [[ -f "$DATA/profile" ]] && cp "$DATA/profile" "$DATA/profile.bak"
      [[ -f "$DATA/scores" ]] && cp "$DATA/scores" "$DATA/scores.bak"
      printf '%s\n' "Profile version mismatch (got $_file_ver, want $_PROFILE_VER) — reset. Backup in profile.bak/scores.bak" >&2
      PLAYER_NAME="" BOSS_BEATEN=0 BEST_CHALLENGE=0 DISKS_FOUND="" SC_DONE="" LAST_DECAY=0 PLACED_THROUGH=0
      : > "$DATA/scores"
      rm -f "$DATA"/*.json
      # Persist the reset NOW so a quit-before-save can't re-enter this path and
      # overwrite the good backup with the already-emptied scores on next launch.
      # Raw write: merging would resurrect fields from the incompatible old profile.
      _write_profile
    fi
  fi
}

# Raw write, no merge — only for paths that must overwrite disk (version reset).
_write_profile() {
  printf 'PLAYER_NAME=%s\nBOSS_BEATEN=%d\nBEST_CHALLENGE=%d\nDISKS_FOUND=%s\nSC_DONE=%s\nLAST_DECAY=%d\nOPT_VI=%d\nOPT_SOUND=%d\nOPT_ALTS=%d\nPLACED_THROUGH=%d\nPROFILE_VER=%d\n' \
    "$PLAYER_NAME" "$BOSS_BEATEN" "$BEST_CHALLENGE" "$DISKS_FOUND" "$SC_DONE" "$LAST_DECAY" "$OPT_VI" "$OPT_SOUND" "$OPT_ALTS" "$PLACED_THROUGH" "$_PROFILE_VER" > "$DATA/profile.tmp" \
    && mv "$DATA/profile.tmp" "$DATA/profile" \
    || rm -f "$DATA/profile.tmp"  # never let a partial write replace a good profile
}
# CSV union helper: add each item of $2 missing from the CSV in the var named $1.
_csv_merge() {
  local -n _cv=$1; local _it
  for _it in ${2//,/ }; do
    [[ ",$_cv," == *",$_it,"* ]] || _cv="${_cv:+$_cv,}$_it"
  done
}
_save_profile() {
  # Lock + monotonic merge (mirrors the scores pattern): a second instance's save
  # was last-writer-wins, silently reverting boss/placement progress the other
  # instance had already written. Progress fields take max(disk, memory), CSV
  # collections union; options/name stay last-writer.
  local _fd=""
  { exec {_fd}>"$DATA/profile.lock"; } 2>/dev/null && flock -x "$_fd"
  if [[ -f "$DATA/profile" ]]; then
    local key val
    while IFS='=' read -r key val; do
      case "$key" in
        BOSS_BEATEN)    [[ "$val" =~ ^[0-9]+$ ]] && ((val <= MAX_LEVEL && val > BOSS_BEATEN)) && BOSS_BEATEN=$val;;
        PLACED_THROUGH) [[ "$val" =~ ^[0-9]+$ ]] && ((val <= MAX_LEVEL && val > PLACED_THROUGH)) && PLACED_THROUGH=$val;;
        BEST_CHALLENGE) [[ "$val" =~ ^[0-9]+$ ]] && ((val > BEST_CHALLENGE)) && BEST_CHALLENGE=$val;;
        DISKS_FOUND)    [[ -n "$val" ]] && _csv_merge DISKS_FOUND "$val";;
        SC_DONE)        [[ -n "$val" ]] && _csv_merge SC_DONE "$val";;
      esac
    done < "$DATA/profile"
  fi
  _write_profile
  [[ -n "$_fd" ]] && exec {_fd}>&-
}

_first_run() {
