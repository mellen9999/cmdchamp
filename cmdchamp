_sandbox_init() {
  ((SANDBOX_MODE)) || return 0
  _check_bwrap || return 1
  # Check available disk space (need at least 10MB)
  local _avail; _avail=$(df -kP "${DATA%/*}" 2>/dev/null | awk 'NR==2{print $4}')
  if [[ -n "$_avail" ]] && ((_avail < 10240)); then
    printf '%s\n' "${Y}Warning: low disk space, sandbox disabled${N}" >&2
    SANDBOX_MODE=0; return 1
  fi
  # Reap orphans from a signal landing mid-swap in _sandbox_reset: the rename-aside
  # (sandbox.old.<pid>) and mktemp staging (sandbox.XXXXXX) dirs are never reused.
  local _orph
  for _orph in "$SANDBOX_DIR".old.* "$SANDBOX_DIR".[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]; do
    [[ -d "$_orph" && "$_orph" != "$SANDBOX_PRISTINE" ]] || continue
    chmod -R u+rwX "$_orph" 2>/dev/null
    rm -rf "$_orph"
  done
  # Also reap scenario-snapshot mktemp staging (sandbox.snap.<6 rand>) orphaned by a
  # signal in the window between its mktemp and rename — same transient-staging class as
  # above, one dot deeper so the globs above miss it. The fixed-name live checkpoint
  # (sandbox.snap/.perms) is deliberately NOT reaped: _mode_init runs on every level and
  # challenge entry, and a concurrent instance may hold sandbox.snap live mid-scenario —
  # deleting it would break its rollback. The next scenario's _sc_snap_save overwrites a
  # stale fixed-name snap, and the exit trap clears it, so it self-heals without this.
  for _orph in "$SANDBOX_DIR".snap.[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]; do
    [[ -d "$_orph" ]] || continue
    chmod -R u+rwX "$_orph" 2>/dev/null
    rm -rf "$_orph"
  done
  # Marker lives outside the pristine tree so it can't leak into the sandbox listing.
  # Bump _SANDBOX_GEN whenever fixture content changes, so stale pristines regenerate.
  local _sbmark="$DATA/.sandbox_gen$_SANDBOX_GEN"
  if [[ ! -d "$SANDBOX_PRISTINE" || ! -f "$_sbmark" ]]; then
    rm -rf "$SANDBOX_PRISTINE"
    _gen_sandbox_files "$SANDBOX_PRISTINE" || return 1
    rm -f "$DATA"/.sandbox_gen*
    : > "$_sbmark"
  fi
  _sandbox_reset
}

_sandbox_reset() {
  ((SANDBOX_MODE)) || return 0
  [[ -d "$SANDBOX_PRISTINE" ]] || return 1
  chmod -R u+rwX "$SANDBOX_DIR" 2>/dev/null  # unlock any restricted dirs (e.g. scenario 4)
  local _sb_tmp; _sb_tmp=$(mktemp -d "${SANDBOX_DIR}.XXXXXX") || { SANDBOX_MODE=0; return 1; }
  # Copy pristine contents INTO the temp dir (avoids rm-then-cp TOCTOU window).
  if ! cp -a "$SANDBOX_PRISTINE/." "$_sb_tmp/"; then
    rm -rf "$_sb_tmp"
    printf '%s\n' "${Y}Warning: sandbox reset failed, disabling${N}" >&2
    SANDBOX_MODE=0; return 1
  fi
  # Atomic-ish swap: rename old aside, move new in, then clean up old.
  # This avoids a window where SANDBOX_DIR doesn't exist (signal-safety).
  local _sb_old="${SANDBOX_DIR}.old.$$"
  if [[ -d "$SANDBOX_DIR" ]]; then
    mv "$SANDBOX_DIR" "$_sb_old" 2>/dev/null || rm -rf "$SANDBOX_DIR"
  fi
  mv "$_sb_tmp" "$SANDBOX_DIR"
  [[ -d "$_sb_old" ]] && rm -rf "$_sb_old"
  return 0  # the [[ -d ]] guard above must not leak exit 1 on the common no-old-dir path
}

_sandbox_exec() {
  local cmd="$1" timeout_sec="${2:-$SANDBOX_TIMEOUT}"
  ((SANDBOX_MODE)) || return 1
  local -a bwrap_args=(
    --clearenv
    --setenv PATH /usr/bin:/bin
    --setenv HOME /sandbox
    --setenv USER sandbox
    --setenv SHELL /bin/bash
    --setenv LANG "${LANG:-C.UTF-8}"
    --setenv TERM "${TERM:-xterm-256color}"
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /etc/passwd /etc/passwd
    --ro-bind /etc/group /etc/group
    --bind "$SANDBOX_DIR" /sandbox
    --chdir /sandbox
    --unshare-all
    --die-with-parent
    --new-session
    --dev /dev
    --size $((64*1024*1024)) --tmpfs /tmp
  )
  [[ -e /lib ]] && bwrap_args+=(--ro-bind /lib /lib)
  [[ -e /lib64 ]] && bwrap_args+=(--ro-bind /lib64 /lib64)
  # Debian/Ubuntu front core tools (awk→mawk, vi, pager, ...) via /etc/alternatives
  # symlinks. Without this bind those symlinks dangle in the sandbox and the tool
  # silently produces nothing — awk answers would fail for every Debian-family user.
  [[ -e /etc/alternatives ]] && bwrap_args+=(--ro-bind /etc/alternatives /etc/alternatives)

  local _rc
  # ulimit -u caps processes inside the sandbox so a fork bomb can't pin a core
  # for the full timeout window. 256 is far above anything a real lesson needs.
  # ulimit -f caps file size (64MB) so dd/yes into /sandbox can't fill the real disk in the timeout window
  timeout "$timeout_sec" bwrap "${bwrap_args[@]}" /bin/bash -c 'ulimit -u 256 2>/dev/null; ulimit -f 65536 2>/dev/null; eval "$1"' -- "$cmd"; _rc=$?
  ((_rc >= 125)) && printf '%s\n' "${R}sandbox error (exit ${_rc})${N}" >&2
  return "$_rc"
}

_SANDBOX_DESTRUCTIVE=0
_is_destructive() {
  local cmd="$1"
  # trailing ([[:space:]]|$) so pipeline tails like `xargs gzip` / `fd -X gzip` still match
  [[ "$cmd" =~ (^|[[:space:];&|])(rm|mv|cp|dd|truncate|shred|unlink|tee|chmod|chown|mkfs|fdisk|parted|install|split|patch|ln|mkdir|touch|tar|gzip|gunzip|bzip2|xz|zip|unzip|rename)([[:space:]]|$) ]] && return 0
  [[ "$cmd" =~ ([^0-9\<\>]|^|[0-9])(\>\>|\>[^>]) ]] && return 0
  [[ "$cmd" =~ sed[[:space:]]+(-i|--in-place) ]] && return 0
  [[ "$cmd" =~ (^|[[:space:];&|])sort[[:space:]].*(-o|--output) ]] && return 0
  [[ "$cmd" =~ :[[:space:]]*\> ]] && return 0
  [[ "$cmd" =~ find[[:space:]].*-delete ]] && return 0
  [[ "$cmd" =~ rsync[[:space:]].*--delete|xargs[[:space:]].*(rm|mv)|find[[:space:]].*-exec[[:space:]].*(rm|mv) ]] && return 0
  [[ "$cmd" =~ (^|[[:space:];&|])(eval|exec|source)[[:space:]] ]] && return 0
  [[ "$cmd" =~ \&\> ]] && return 0
  return 1
}

# Returns 0 if output matches expected
# Formats:
#   exact text - exact match
#   ~regex     - regex match
#   @N         - line count match
#   *          - any output (just check command ran)
_sandbox_check_output() {
  local actual="$1" expected="$2"
  [[ -z "$expected" ]] && return 1

  case "$expected" in
    \~*)  # Regex match
      local pattern="${expected:1}"
      [[ "$actual" =~ $pattern ]] && return 0
      ;;
    @*)   # Line count match
      local count="${expected:1}"
      local lines=0
      if [[ -n "$actual" ]]; then
        actual="${actual%$'\n'}"
        local _lc="${actual//[!$'\n']/}"; lines=$(( ${#_lc} + 1 ))
      fi
      ((lines == count)) && return 0
      ;;
    \*)   # Any output
      [[ -n "$actual" ]] && return 0
      ;;
    *)    # Exact match (trimmed)
      _trim "$actual"; actual=$REPLY
      _trim "$expected"; expected=$REPLY
      [[ "$actual" == "$expected" ]] && return 0
      ;;
  esac
  return 1
}

# Formats: exists:F, !exists:F, contains:F:S, !contains:F:S, lines:F:N, line1:F:T, perm:F:M
_sandbox_check_state() {
  local checks="$1" checks_arr=()
  # Split on commas only when followed by a check keyword (avoids breaking values with commas)
  local _rem="$checks" _seg
  while [[ -n "$_rem" ]]; do
    if [[ "$_rem" =~ ^((!?(exists|contains|lines|line1|perm)):[^,]*),((!?(exists|contains|lines|line1|perm)):) ]]; then
      _seg="${BASH_REMATCH[1]}"
      _rem="${_rem:${#_seg}+1}"
    else _seg="$_rem"; _rem=""; fi
    checks_arr+=("$_seg")
  done
  for check in "${checks_arr[@]}"; do
    case "$check" in
      exists:*|!exists:*)
        local _neg=0; [[ "$check" == !* ]] && { _neg=1; check="${check:1}"; }
        local file="${check#exists:}"
        ((_neg)) && { [[ ! -e "$SANDBOX_DIR/$file" ]] || return 1; } || { [[ -e "$SANDBOX_DIR/$file" ]] || return 1; }
        ;;
      contains:*:*|!contains:*:*)
        local _neg=0; [[ "$check" == !* ]] && { _neg=1; check="${check:1}"; }
        local rest="${check#contains:}"; local file="${rest%%:*}" pattern="${rest#*:}"
        if ((_neg)); then grep -qFe "$pattern" -- "$SANDBOX_DIR/$file" 2>/dev/null && return 1
        else grep -qFe "$pattern" -- "$SANDBOX_DIR/$file" 2>/dev/null || return 1; fi  # -e: a pattern starting with - must not parse as grep options
        ;;
      lines:*:*)
        local rest="${check#lines:}"; local file="${rest%%:*}" count="${rest#*:}"
        [[ -f "$SANDBOX_DIR/$file" ]] || { ((count == 0)) && continue || return 1; }
        local _lc_buf actual
        IFS= read -rd '' _lc_buf < "$SANDBOX_DIR/$file" ||:
        actual="${_lc_buf//[!$'\n']/}"; actual=${#actual}
        ((actual == count)) || return 1
        ;;
      line1:*:*)
        local rest="${check#line1:}"; local file="${rest%%:*}" text="${rest#*:}"
        local first=""; read -r first < "$SANDBOX_DIR/$file" 2>/dev/null || [[ -n "$first" ]] || return 1  # EOF w/o newline still populates first
        [[ "$first" == *"$text"* ]] || return 1
        ;;
      perm:*:*|!perm:*:*)
        local _neg=0; [[ "$check" == !* ]] && { _neg=1; check="${check:1}"; }
        local rest="${check#perm:}"; local file="${rest%%:*}" perms="${rest#*:}"
        local path="$SANDBOX_DIR/$file"
        [[ ! -e "$path" ]] && { ((_neg)) && continue || return 1; }
        local _p; for ((_p=0; _p<${#perms}; _p++)); do
          test -"${perms:$_p:1}" "$path"; local _prc=$?; ((_neg ? !_prc : _prc)) && return 1; done
        ;;
    esac
  done
  return 0
}
# ═══ SESSION ═══
_stty_saved=$(stty -g 2>/dev/null) || _stty_saved=""
_interactive=0 _CLEANING=0 _RL_W=80
_cleanup() {
  # Flush + terminal restore BEFORE the re-entrancy guard: menu-quit paths pre-set
  # _CLEANING=1 then exit (to skip the session summary), which would otherwise also
  # skip these. All idempotent, so a re-entrant cleanup can't double-write or garble.
  _sflush_if_dirty 2>/dev/null
  [[ -n "$_stty_saved" ]] && stty "$_stty_saved" 2>/dev/null
  ((_interactive)) && printf '\e[?25h\e[?2004l'  # restore cursor + disable bracketed paste
  ((_CLEANING)) && return; _CLEANING=1
  ((_interactive)) || return 0
  rm -rf "$DATA/sandbox.snap" "$DATA/sandbox.snap.perms" 2>/dev/null
  if ((_S_ANSWERED > 0)); then
    local _ts; printf -v _ts '%(%s)T' -1; local el=$((_ts - _S_START))
    printf '\n%s  %s/%s (%d%%)  streak %s  %dm%ds\n' \
      "${U}Session${N}" "${G}${_S_CORRECT}${N}" "${_S_ANSWERED}" \
      $((_S_CORRECT*100/_S_ANSWERED)) "${W}${_S_BEST_STREAK}${N}" \
      $((el/60)) $((el%60))
  else echo; fi
}
# EXIT trap must NOT call exit — that would clobber the script's real exit code
# (e.g. `cmdchamp test` returning non-zero on failure, which CI depends on).
trap '_cleanup' EXIT
trap '_cleanup; exit 130' INT
trap '_cleanup; exit 143' TERM
trap '_cleanup; exit 129' HUP
((EUID == 0)) && PROMPT_CHAR='# ' || PROMPT_CHAR='$ '
PROMPT_CHAR="${CMD_PROMPT:-$PROMPT_CHAR}"

# ═══ FLOPPY DISKS ═══
_DISK_TOTAL=8
declare -A _DISK_DESC=(
  [sudorm]="Answer sudo rm -rf /"
  [forkbomb]="Answer a fork bomb"
  [rtfm]="Answer just 'man' with no arguments"
  [streak10]="Get a 10+ answer streak"
  [nightowl]="Play between midnight and 4am"
  [flawless]="Beat a boss without a single mistake"
  [vimquit]="Try to :q! or :wq out of the game"
  [completionist]="Complete all scenarios"
)
_disk_found() {
  local name=$1
  [[ ",$DISKS_FOUND," == *",$name,"* ]] && return
  [[ -n "$DISKS_FOUND" ]] && DISKS_FOUND="$DISKS_FOUND,$name" || DISKS_FOUND="$name"
  _save_profile
  _csv_count "$DISKS_FOUND"; local disk_count=$REPLY
  printf '\n%s\n' "${Y}${B}▄▄▄▄▄▄▄${N}"
  printf '%s\n'   "${Y}${B}█ ░░░ █${N}  ${Y}${B}FLOPPY DISK: ${name}${N}"
  printf '%s\n'   "${Y}${B}█▄▄▄▄▄█${N}  ${D}${_DISK_DESC[$name]:-}${N}"
  printf '%s\n'   "${Y}${B}███████${N}  ${D}${disk_count}/${_DISK_TOTAL} collected${N}"
  printf '%s\n\n' "${Y}${B}▀▀▀▀▀▀▀${N}"
  sleep 5
}
_disk_check() {
  local trigger=$1 ctx=${2:-}
  case "$trigger" in
    wrong)
      [[ "$ctx" == "sudo rm -rf /"* ]] && _disk_found sudorm
      [[ "$ctx" == *":()"*":|:"* ]] && _disk_found forkbomb
      [[ "$ctx" == "man" ]] && _disk_found rtfm
      [[ "$ctx" == ":q"* || "$ctx" == ":wq"* ]] && _disk_found vimquit
      ;;
    streak) ((_S_STREAK >= 10)) && _disk_found streak10;;
    nightowl) local h; printf -v h '%(%H)T' -1; ((10#$h < 4)) && _disk_found nightowl;;
    flawless) _disk_found flawless;;
    completionist)
      local i done=1
      for ((i=1; i<=SC_TOTAL; i++)); do
        [[ ",$SC_DONE," == *",$i,"* ]] || { done=0; break; }
      done
      ((done)) && _disk_found completionist
      ;;
  esac
}

