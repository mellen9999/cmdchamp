  printf '    %s      The daemons are silent. The descent is complete.        %s\n' "$br" "$br"
  printf '    %s      What remains bends to your command.                     %s\n' "$br" "$br"
  printf '    %s                                                              %s\n' "$br" "$br"
  printf '    %s      30 bosses defeated. The shell is yours.                 %s\n' "$br" "$br"
