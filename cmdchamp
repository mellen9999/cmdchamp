      "${B}Session${N}" "${G}${_S_CORRECT}${N}" "${_S_ANSWERED}" \
      $((_S_CORRECT*100/_S_ANSWERED)) "${W}${_S_BEST_STREAK}${N}" \
      $((el/60)) $((el%60))
  else echo; fi
}
