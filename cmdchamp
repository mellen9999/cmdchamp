# ═══ VI HANDLER ═══
_yankn() { # $1=motion $2=count — accumulate N objects (the range is idempotent, so
  # a stationary repeat would re-copy the same text); cursor is restored afterwards.
  local _m=$1 _c=$2 _sv=$cursor _acc=""
  case "$_m" in y) _vi_reg="$input"; return;; esac
  _vi_ft=""  # read a find-motion target once, reuse across the counted repeats
  for ((;_c>0;_c--)); do
    _vi_range "$_m" || break
    if ((_rs<cursor)); then _acc="${input:_rs:_re-_rs}$_acc"; cursor=$_rs
    else _acc+="${input:_rs:_re-_rs}"; cursor=$_re; fi
