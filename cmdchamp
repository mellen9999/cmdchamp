  # Mix in weak questions from previous levels (unmastered first)
  if ((level > 1)) && declare -p _sc &>/dev/null 2>&1; then
    local _weak=() _rest=() _cache_tmp=() _line prev
    for ((prev=1; prev<level; prev++)); do
      if [[ -z "${_LEVEL_CACHE[$prev]:-}" ]]; then
        _cache_tmp=(); "gen_level${prev}" _cache_tmp
        IFS=$'\n'; _LEVEL_CACHE[$prev]="${_cache_tmp[*]}"
      fi
      while IFS= read -r _line; do
        [[ -z "$_line" ]] && continue
        _qparse "$_line"; _sget "$_qprompt"
        ((REPLY < 2)) && _weak+=("$_line") || _rest+=("$_line")
      done <<< "${_LEVEL_CACHE[$prev]}"
    done
    _fshuffle _weak; _fshuffle _rest
    # Take up to MIX_PER_LEVEL * (level-1) questions, weak first
    local _want=$(( MIX_PER_LEVEL * (level - 1) )) _got=0
    for _line in "${_weak[@]}" "${_rest[@]}"; do
      ((_got >= _want)) && break
      CURRENT_QUESTIONS+=("$_line"); ((_got++))
    done
  fi
}

# ═══ ANSWER CHECK ═══
_fnorm() {
  [[ -z "$1" ]] && { REPLY=""; return; }
  # Byte-order collation so flag sorting (and tar-char sorting) is identical in every
  # locale — otherwise the same command normalizes differently under C vs en_US, since
  # UTF-8 collation treats the leading hyphens of long flags as ignorable.
  local LC_ALL=C
  # Handle statement separators (&&, ||, ;): normalize each segment independently and
  # rejoin with the literal separator, so a flag in one segment can't hoist into the next
  # (grep x f > t && mv -v t f must NOT normalize equal to grep -v x f > t && mv t f) and
  # `a && b` never matches `a ; b`. Protect find's `\;` terminator so it isn't a boundary.
  local _prot="${1//\\;/$'\x03'}"
  if [[ "$_prot" == *'&&'* || "$_prot" == *'||'* || "$_prot" == *';'* ]]; then
    # Distinct control-char markers per separator (& is special in a replacement string,
    # so we can't put a literal && there); \x05=&&  \x06=||  \x07=; — split on \x04.
    _prot="${_prot//&&/$'\x04\x05\x04'}"
    _prot="${_prot//||/$'\x04\x06\x04'}"
    _prot="${_prot//;/$'\x04\x07\x04'}"
    local -a _toks; IFS=$'\x04' read -ra _toks <<< "$_prot"
    local _out="" _tk
    for _tk in "${_toks[@]}"; do
      case "$_tk" in
        $'\x05') _out+=" && " ;;
        $'\x06') _out+=" || " ;;
        $'\x07') _out+=" ; " ;;
        *)
          _tk="${_tk//$'\x03'/\\;}"; _trim "$_tk"; _tk=$REPLY
          # empty segment => leading/trailing/double separator (malformed) — sentinel it
          [[ -z "$_tk" ]] && { REPLY=$'\x02'; return; }
          _fnorm "$_tk"; _out+="$REPLY" ;;
      esac
    done
    _trim "$_out"; return
  fi
  # Handle pipes: normalize each segment independently (protect || from splitting)
  if [[ "$1" == *'|'* ]]; then
    local _segs _s _r="" _pg="${1//||/$'\x01'}"
    if [[ "$_pg" == *'|'* ]]; then
      IFS='|' read -ra _segs <<< "$_pg"
      for _s in "${_segs[@]}"; do
        _s="${_s//$'\x01'/||}"; _trim "$_s"; _s=$REPLY
        # An empty stage means a malformed pipe (leading/trailing/double "|").
        # Real commands never have one — return a sentinel so it can't match a
        # canonical answer (else "| sort f" would normalize equal to "sort f").
        [[ -z "$_s" ]] && { REPLY=$'\x02'; return; }
        _fnorm "$_s"
        [[ -n "$_r" ]] && _r+=" | "
        _r+="$REPLY"
      done
      REPLY="$_r"; return
    fi
  fi
  local parts flags=() args=() postdd=() p j
  read -ra parts <<< "$1"
  # Preprocess: split on ; boundaries (cmd; cmd2 → cmd ; cmd2)
  local _semi=() _sp
  for _sp in "${parts[@]}"; do
    if [[ "$_sp" == *';'* && "$_sp" != ';' && "$_sp" != '\;' ]]; then
      # split every ; in the token (a;b;c → a ; b ; c); leave find's \; terminator intact
      while [[ "$_sp" == *';'* ]]; do
        local _pre="${_sp%%;*}"
        [[ -n "$_pre" ]] && _semi+=("$_pre")
        _semi+=(";")
        _sp="${_sp#*;}"
      done
      [[ -n "$_sp" ]] && _semi+=("$_sp")
    else _semi+=("$_sp"); fi
  done
  parts=("${_semi[@]}")
  # Preprocess: split combined redirect tokens (>file → > file, 2>/dev/null → 2> /dev/null)
  local _redir='^(2>>|2>|>>|>&|&>|1>|>|<)([^<>&(].*)$' _pp=()
