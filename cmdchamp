    b="${a#"${a%%[![:space:]]*}"}"; b="${b%"${b##*[![:space:]]}"}"
    [[ -z "$b" || "$b" == ~* ]] && continue
    _fnorm "$b"
    [[ "$inp" == "$b" || "$ninp" == "$REPLY" ]] && continue
