  _fpick IMGS; img=$REPLY; _fpick PCAPS; pcap=$REPLY; _fpick HASHES; hash=$REPLY; _fpick PHOTOS; photo=$REPLY
  _fpick WORDLISTS; wordlist=$REPLY; _fpick IPS; ip=$REPLY; _fpick SUBNETS; subnet=$REPLY
