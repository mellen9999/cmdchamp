  local _di_viol=0 _di_q _di_s
  for ((_lv=1; _lv<=30; _lv++)); do
    local _di_arr=(); "gen_level${_lv}" _di_arr
    for _di_s in "${_di_arr[@]}"; do
      if [[ "$_di_s" != *§* && "$_di_s" == *" | "* ]]; then
        ((_di_viol++)); printf '  FAIL: L%d uses | delimiter with a shell pipe: %s\n' "$_lv" "${_di_s:0:70}"
      fi
    done
  done
  if ((_di_viol)); then ((_fail++)); else ((_pass++)); fi

  printf '%s\n' "${B}=== challenge filter ===${N}"
  local _trials_per_lv=200 _trial _tagged_drawn=0 _untagged_drawn=0
  for _lv in 26 27 28 29 30; do
    unset "_LEVEL_CHAL[$_lv]"
    for ((_trial=0; _trial<_trials_per_lv; _trial++)); do
      _pick_q "$_lv" challenge || continue
      if ((_qboss_skip || _qchal_skip)); then ((_tagged_drawn++)); else ((_untagged_drawn++)); fi
    done
  done
  _assert "challenge filter excludes all tagged prompts (1000 draws)" "$_tagged_drawn" "0"
  if ((_untagged_drawn < 900)); then
    ((_fail++)); printf '  FAIL: challenge filter only drew %d/1000 untagged prompts\n' "$_untagged_drawn"
  else
    ((_pass++))
  fi

  printf '%s\n' "${B}=== boss filter ===${N}"
  local _bf_total=0 _bf_boss_tagged=0
  for _lv in 26 27 28 29 30; do
    local _bf_q=()
    mapfile -t _bf_q <<< "${_LEVEL_CACHE[$_lv]}"
    for q in "${_bf_q[@]}"; do
      [[ -n "$q" ]] || continue
      ((_bf_total++))
      _qparse "$q"
      ((_qboss_skip)) && ((_bf_boss_tagged++))
    done
  done
  if ((_bf_boss_tagged >= 20)); then
    ((_pass++))
  else
    ((_fail++)); printf '  FAIL: boss filter found only %d boss-skip prompts in L26-30 (expected >= 20)\n' "$_bf_boss_tagged"
  fi
  _assert "boss filter sees post-tag pool" "$((_bf_total > 100))" "1"
  # Per-level pool floor: each L26-30 must retain enough prompts after tagging
  # to fill a 5-question boss round (BOSS_TOTAL) — 10x headroom = 50 minimum.
  local _poolfail=0 _ph_lv _ph_total _ph_skip
  for _ph_lv in 26 27 28 29 30; do
    local _ph_q=()
    mapfile -t _ph_q <<< "${_LEVEL_CACHE[$_ph_lv]}"
    _ph_total=0; _ph_skip=0
    for q in "${_ph_q[@]}"; do
      [[ -n "$q" ]] || continue
      ((_ph_total++)); _qparse "$q"; ((_qboss_skip)) && ((_ph_skip++))
    done
    if (( _ph_total - _ph_skip < BOSS_TOTAL * 2 )); then
      _poolfail=1; printf '  FAIL: L%d boss-eligible pool too thin (%d/%d)\n' "$_ph_lv" "$((_ph_total - _ph_skip))" "$_ph_total"
    fi
  done
  if ((_poolfail)); then ((_fail++)); else ((_pass++)); fi

  printf '\n%s%s✓ %d passed%s, ' "$B" "$G" "$_pass" "$N"
  ((_fail)) && printf '%s%s✗ %d failed%s\n' "$B" "$R" "$_fail" "$N" || printf '%s✓ 0 failed%s\n' "$D" "$N"
  return $((_fail > 0))
}

# ═══ PLACEMENT ═══
place() {
  printf '%s\e[2J\e[H%s\n%s\n%s\n\n%s' "$_SY" "${M}${B}═══ PLACEMENT TEST ═══${N}" "${D}2 questions per level, 30s each, no manpages${N}" "${D}Miss one → that's your starting level${N}" "$_SN"
  read -rsp "${D}Press Enter to start...${N}"; echo

  _session_init
  _mode_init place
  local lv qi_ok
  for ((lv=1; lv<=MAX_LEVEL; lv++)); do
    qi_ok=0
    for ((qi=1; qi<=2; qi++)); do
      _preq_reset
      _pick_q "$lv" challenge || break 2
      local prompt=$_qprompt ans=$_qans
      _REDRAW_HDR() {
        local _t=30
        if ((${_rl_deadline:-0})); then _rl_rem; _t=$REPLY; fi
        printf '%s\e[H%s  %s  %s\e[K\n\e[K\n%s\e[K\n\e[K\n%s' "$_SY" "${U}Level ${lv}${N}" "${U}Q${qi}/2${N}" "${W}${_t}s${N}" "${C}${prompt}${N}" "$_SN"
      }
      printf '\e[2J'; _REDRAW_HDR
      if _read_line 0 0 30; then
        ((_QUIT)) && break 2
        if check "$input" "$_qanswers"; then
          printf '%s\n' "${G}${B}+${N}"; ((qi_ok++)); _pause
          continue
        fi
      else
        ((_QUIT)) && break 2
      fi
      # Wrong or timed out
      printf '\n%s  %s %s\n' "${R}${B}✗${N}" "${D}expected:${N}" "${Y}${ans}${N}"
      _pause; break
    done
    ((qi_ok < 2)) && break
  done
  # User quit mid-placement: don't save partial result, exit cleanly
  if ((_QUIT)); then
    _sflush_if_dirty
    printf '%s\n' "${D}placement abandoned${N}"
    return
  fi
  # Set placement
  local placed=$((lv - 1))
  ((qi_ok >= 2 && lv > MAX_LEVEL)) && placed=$MAX_LEVEL
  ((placed > BOSS_BEATEN)) && BOSS_BEATEN=$placed
  ((placed > PLACED_THROUGH)) && PLACED_THROUGH=$placed
  _save_profile
  LVL=$((placed >= MAX_LEVEL ? MAX_LEVEL : placed + 1)); QI=0; save
  printf '%s\e[2J\e[H%s\n' "$_SY" "${G}${B}═══ PLACEMENT COMPLETE ═══${N}"
  if ((placed == 0)); then
    printf '%s\n' "Starting from ${U}Level 1${N}"
  elif ((placed >= MAX_LEVEL)); then
    printf '%s\n' "${G}${B}Perfect!${N} All levels cleared — scenarios + post-ROOT modes unlocked"
  else
    printf '%s\n' "Placed at ${U}Level $((placed + 1))${N}"
    local _si
    for ((_si=1; _si<=SC_TOTAL; _si++)); do
      ((placed >= SC_UNLOCK[_si])) && printf '%s\n' "${G}★ Scenario unlocked: ${SC_NAMES[$_si]}${N}"
    done
  fi
  printf '%s' "$_SN"
  _sflush_if_dirty
  echo
  _pause
}

# ═══ CLI ENTRYPOINT ═══
_args=()
for _a in "$@"; do [[ "$_a" == "--no-sandbox" ]] && SANDBOX_MODE=0 || _args+=("$_a"); done
set -- "${_args[@]+"${_args[@]}"}"

case "${1:-}" in
  test|selftest) _selftest; exit $?;;
  r|reset)
    # Irreversible wipe — confirm on a terminal; stays scriptable when piped/non-interactive.
    if [[ -t 0 ]]; then
      read -rp "wipe all cmdchamp progress? [y/N] " _yn
      [[ "$_yn" =~ ^[Yy]$ ]] || { echo "cancelled"; exit 0; }
    fi
    rm -f "$DATA"/*.json "$DATA/scores" "$DATA/scores.lock" "$DATA/profile" "$DATA/.bwrap_blocked"; rm -rf "$DATA/sandbox" "$DATA/sandbox.pristine" 2>/dev/null; echo "reset";;
  preview)
    # Dev-only: dump all visual content for review
    [[ "${CMDCHAMP_DEV:-}" != "1" ]] && { echo "Unknown command. Try: cmdchamp help"; exit 1; }
    _preview() {
    PLAYER_NAME="${PLAYER_NAME:-preview}" BOSS_BEATEN=30

    printf '%s\n' "${B}═══ INTRO SCREEN ═══${N}"
    _intro nopause

    printf '\n%s\n' "${B}═══ LEVELS & BOSSES ═══${N}"
    for ((lv=1; lv<=MAX_LEVEL; lv++)); do
      printf '\n  %s %2d: %-22s  %sBoss: %-16s%s  %s\n' "${U}Level${N}" "$lv" "${LEVEL_NAMES[$lv]:-}" "${M}" "${BOSS_NAMES[$lv]:-}" "${N}" "${D}\"${BOSS_FLAVOR[$lv]:-}\"${N}"
      local _pq=(); "gen_level$lv" _pq
      for ((_si=0; _si<3 && _si<${#_pq[@]}; _si++)); do
        _qparse "${_pq[$_si]}"
        printf '    %s → %s\n' "${D}$_qprompt${N}" "${G}$_qans${N}"
      done
    done

    printf '\n\n%s\n' "${B}═══ BOSS SPLASH (sample: Level 15) ═══${N}"
    local _sboss="${BOSS_NAMES[15]}" _sflavor="${BOSS_FLAVOR[15]}"
    local s; printf -v s '%*s' $(( (80 - 12) / 2 )) ''
    printf '\n%s%s\n\n' "$s" "${M}${B}═══ BOSS ═══${N}"
    printf -v s '%*s' $(( (80 - ${#_sboss}) / 2 )) ''
    printf '%s%s\n\n' "$s" "${M}${B}${_sboss}${N}"
    printf -v s '%*s' $(( (80 - ${#_sflavor} - 2) / 2 )) ''
    printf '%s%s\n' "$s" "${D}\"${_sflavor}\"${N}"

    printf '\n\n%s\n' "${B}═══ SCENARIOS ═══${N}"
    for ((si=1; si<=SC_TOTAL; si++)); do
      printf '\n  %s %d: %-22s  %s(unlocks at boss %d)%s\n' "${M}${B}Scenario${N}" "$si" "${SC_NAMES[$si]:-}" "${D}" "${SC_UNLOCK[$si]:-0}" "${N}"
      printf '    %s\n' "${D}${SC_FLAVOR[$si]:-}${N}"
    done

    printf '\n\n%s\n' "${B}═══ VICTORY SCREEN ═══${N}"
    _victory nopause
    }; _preview;;
  h|help|-h|--help)
    cat <<EOF
${B}cmdchamp${N} - CLI trainer
${D}30 levels, spaced repetition, sandbox execution${N}

Usage: cmdchamp [--no-sandbox] [command]

Run with no arguments for the game menu.

Options:
  --no-sandbox  Disable sandbox (text-match only — answers checked
                without actually executing them)

Commands:
  r|reset       Reset all progress (also removes sandbox cache)
  test          Run self-tests (no game state touched)
  v|version     Print version
  h|help        Show this help

Environment:
  NO_COLOR      Set to disable ANSI colors
  XDG_DATA_HOME Profile/scores location (default: ~/.local/share/cmdchamp)
  CMD_PROMPT    Override prompt char (default: $ or # for root)

Requirements:
  - bash 4.4+
  - awk
  - bwrap (bubblewrap) — for sandboxed answer execution; without it,
    answers are checked by text match only.

Data files (under \$XDG_DATA_HOME/cmdchamp):
  profile       player name, progress, options
  scores        per-question tier & timestamps (spaced repetition)
  sandbox/      working sandbox dir (re-created per question)
  sandbox.pristine/   pristine template for sandbox resets

Tips:
  - Press Tab during a question to see the relevant manpage.
  - ↑/↓ (or k/j in vi normal mode) recall input history.
  - Vi mode (Options menu): Esc → normal, i/a → insert, h/l/w/b move,
    dw/cw delete/change word.
  - Beat the boss of each level to unlock the next. Boss runs without
    manpages.
  - Some levels (network, hashcrack, forensics, privesc) run their
    answers via text-match only — the tools or contexts can't run in
    bwrap. Type the command precisely.
EOF
    ;;
  v|version|-v|--version) printf '%s\n' "$VERSION";;
  "") _tty; _load_profile; _apply_opts; ((SANDBOX_MODE)) && _check_bwrap; _main_menu;;
  *) echo "Usage: cmdchamp [--no-sandbox] [reset|test|version|help]"; echo "Run with no arguments for the game menu."; exit 1;;
esac
