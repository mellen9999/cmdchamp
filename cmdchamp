  local _atf_long=" --delimiter --field-separator --fields --field --key --max-count --color --sort --reference --filter --hash-type --rules-file --since --until --regexp --file --include --exclude --exclude-dir --after-context --before-context --context --max-depth --maxdepth --mindepth "
  local _rp=("${parts[0]}") _ri=1 _np=${#parts[@]} _ct _nt _is_atf
  while ((_ri < _np)); do
